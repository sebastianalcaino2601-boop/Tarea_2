        "            if (conjuntoL[i] == e) {\n",
        "                return i;\n",
        "            }\n",
        "        }\n",
        "        return -1;\n",
        "    }\n",
        "\n",
        "    private static int buscarPosicionInt(int e) { //Función creada por Sebastián Alcaino Aravena\n",
        "        for (int i = 0; i < tam; i++) {\n",
        "            if (conjuntoN[i] == e) {\n",
        "                return i;\n",
        "            }\n",
        "        }\n",
        "        return -1;\n",
        "    }\n",
        "\n",

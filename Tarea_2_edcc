        "import java.util.Scanner;\n",
        "\n",
        "public class Main {\n",
        "    static Scanner sc = new Scanner(System.in);\n",
        "    static int[] conjuntoN;\n",
        "    static char[] conjuntoL;\n",
        "    static boolean[][] relacion;\n",
        "    static int tam;\n",
        "\n",
        "    public static void main(String[] args) {\n",
        "        menu();\n",
        "    }\n",
        "\n",

        "        int i = 0;\n",
        "        do {\n",
        "            i = sc.nextInt();\n",
        "            if (i <= 0) {\n",
        "                System.out.println(\"\"\"\n",
        "                        No puede ser igual o menor a 0\n",
        "                        Ingrese nuevamente:\"\"\");\n",
        "            }\n",
        "        } while (i <= 0);\n",
        "        return i;\n",
        "    }\n",
        "}"
